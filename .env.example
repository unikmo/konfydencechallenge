# Database — PostgreSQL / Supabase
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET="replace-with-a-long-random-secret"

# Admin — /admin fails closed when these are absent
ADMIN_USER=""
ADMIN_PASSWORD=""

# Analytics — required for production funnel observability.
# The browser does not load GA until the user explicitly grants analytics consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Lead / pilot email — required for production lead-generation acceptance.
RESEND_API_KEY=""
CONTACT_FROM_EMAIL=""
CONTACT_TO_EMAIL=""

# Shopify commerce — current production checkout provider.
SHOPIFY_STORE_DOMAIN="shop.konfydence.com"
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
SHOPIFY_WEBHOOK_SECRET=""

# Stripe — optional/future. Current checkout is Shopify, so QA reports Stripe as not applicable when unset.
STRIPE_SECRET_KEY=""
