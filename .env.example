# Database — PostgreSQL / Supabase
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET="replace-with-a-long-random-secret"

# Admin — /admin fails closed when these are absent
ADMIN_USER=""
ADMIN_PASSWORD=""

# Analytics — required for production funnel observability.
# The browser does not load GA until the user explicitly grants analytics consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Lead / pilot email — required for production lead-generation acceptance.
RESEND_API_KEY=""
CONTACT_FROM_EMAIL=""
CONTACT_TO_EMAIL=""

# Stripe — checkout, invoicing and subscriptions (PlanetHike OÜ account).
# Use sk_test_/pk_test_ for staging.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
# From Stripe → Developers → Webhooks, one endpoint at /api/webhooks/stripe.
STRIPE_WEBHOOK_SECRET=""
# Set to "true" only after the Stripe Tax wizard is complete (origin address +
# registrations). Until then automatic_tax stays off — which is already the
# right outcome for EU B2B reverse charge.
STRIPE_TAX_ENABLED=""
# Optional: internal address that Workplace/School invoice + payment alerts CC.
LOCKSCREENS_SALES_EMAIL=""
