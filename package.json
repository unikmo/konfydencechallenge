{
  "name": "konfydencechallenge",
  "version": "1.0.0",
  "description": "**Konfydence Challenge** is an online scenario-based decision game that helps users practice safer responses to real-world scams before they happen.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "lib": "lib",
    "test": "tests"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed": "ts-node --transpile-only prisma/seed.ts",
    "qa:webhooks": "ts-node --transpile-only scripts/qa-webhook-matrix.ts",
    "audit:scenarios": "node scripts/audit-scenario-quality.cjs",
    "report:decks": "node scripts/deck-report.cjs"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unikmo/konfydencechallenge.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "next": "15.5.21",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.21",
    "jest": "^30.4.2",
    "prisma": "^5.20.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
