{
  "name": "konfydencechallenge",
  "version": "1.0.0",
  "description": "Konfydence Challenge is a scenario-based decision game that helps people practise safer responses to real-world scams before they happen.",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/bootstrap-comasy-production.cjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "ts-node --transpile-only prisma/seed.ts",
    "db:seed:lockscreens": "ts-node --transpile-only scripts/ingest-lockscreen-assets.ts",
    "db:verify": "ts-node --transpile-only scripts/verify-backend.ts",
    "db:bootstrap": "npm run db:seed && npm run db:verify",
    "seed": "npm run db:seed",
    "qa:webhooks": "ts-node --transpile-only scripts/qa-webhook-matrix.ts",
    "stripe:sync": "ts-node --transpile-only scripts/stripe-sync-catalog.ts",
    "audit:scenarios": "node scripts/audit-scenario-quality.cjs",
    "audit:claims": "node scripts/validate-product-claims.cjs",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "report:decks": "node scripts/deck-report.cjs"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unikmo/konfydencechallenge.git"
  },
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.1",
    "next": "16.3.1",
    "otpauth": "^9.5.2",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "stripe": "^22.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "jest": "^30.4.2",
    "prisma": "^5.20.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
