generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// V1 foundation (Postgres via Supabase): avoid enums and Json types
// for schema simplicity/back-compat with the original SQLite design.

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  sessions      ChallengeSession[]
  entitlements  Entitlement[]
}

model Scenario {
  id          String @id @default(cuid())
  externalId String @unique

  // "travelsafe" | "university" | "workplace" | "school" | "family"
  edition String

  // Deck-specific content grouping (e.g. "Gaming/Social", "Money"). Free text, deck-defined.
  category String?

  // "scenario" (scored, V1 solo web) | "wild" (host-mode only, excluded from V1 solo scoring)
  cardType String @default("scenario")

  // Whether this card counts toward KRS scoring. Wild cards are false.
  scored Boolean @default(true)

  // Legacy sequencing bucket, unused by the flat 50-card deck model. Kept for backward compatibility.
  section String?

  // HACK trigger key: "H" (Hurry) | "A" (Authority) | "C" (Connection) | "K" (Kill-Switch).
  // Null for non-scored (wild) cards.
  hackKey String?


  title  String?
  prompt String

  answersA String
  answersB String
  answersC String
  answersD String

  // normalized 0..4 (import clamps)
  scoresA Int
  scoresB Int
  scoresC Int
  scoresD Int

  // For V1 we keep safeActions/tags as comma-separated strings.
  safeActions String? // e.g. "C,D"
  tags         String? // e.g. "travel,phishing"

  explanation String?
  proTip      String?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessionCards ChallengeSessionCard[]
}

model ChallengeSession {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id])

  // "travelsafe" | "university" | "workplace" | "school" | "family"
  edition String

  // "diagnostic" (5 scored cards, free) | "full" (up to 50 scored cards, paid)
  mode String @default("full")

  // 1-based attempt count for this user+edition+mode. Counting only — does not
  // itself enforce the "5 replay runs included" entitlement (see HANDOFF.md §2.6/§4.2).
  runNumber Int @default(1)

  // "IN_PROGRESS" | "COMPLETED"
  status String @default("IN_PROGRESS")

  // flat pointer into `cards` ordered by orderIndex — no section grouping (HANDOFF.md §2.8)
  currentIndex Int @default(0)
  scoreTotal   Int @default(0)
  scoreMax     Int @default(0)

  completedAt DateTime?

  cards ChallengeSessionCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChallengeSessionCard {
  id        String @id @default(cuid())

  sessionId String
  session   ChallengeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id])

  // position in the flat deck order, persisted so refresh doesn't reshuffle mid-game
  orderIndex Int

  answered          Boolean @default(false)
  selectedAnswerKey String? // "A" | "B" | "C" | "D"
  score             Int?    // 0..4, set once answered

  createdAt DateTime @default(now())

  @@unique([sessionId, orderIndex])
  @@index([scenarioId])
  @@index([sessionId])
}

model Entitlement {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  tier           String   // "single" | "unlimited"
  edition        String?  // set when tier = "single"; null covers all editions
  source         String   @default("shopify")
  shopifyOrderId String   @unique
  status         String   @default("active") // "active" | "revoked"
  createdAt      DateTime @default(now())

  @@index([userId])
}

