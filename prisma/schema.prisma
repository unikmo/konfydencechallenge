generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  // The Konfydence account this challenge player belongs to, once claimed.
  // Null for anonymous kf_uid visitors who have not signed in.
  accountId String?  @unique
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  sessions     ChallengeSession[]
  entitlements Entitlement[]
}

// ---------------------------------------------------------------------------
// Unified accounts (docs/UNIFIED_ACCOUNTS_PLAN.md)
// Passwordless email + optional passkeys/TOTP. One account spans the Challenge
// game and Lockscreens self-serve admin. CoMaSy is out of scope for v1.
// ---------------------------------------------------------------------------

model Account {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerifiedAt DateTime?
  emailOptOut     Boolean   @default(false) // suppresses non-essential email
  createdAt       DateTime  @default(now())

  sessions      AuthSession[]
  passkeys      Passkey[]
  totp          TotpCredential?
  players       User[]
  subscriptions LockscreenTenant[]
}

model AuthSession {
  id         String   @id // SHA-256 of the cookie token; the raw token is never stored
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  userAgent  String?
  ipHash     String?

  @@index([accountId])
  @@index([expiresAt])
}

model LoginCode {
  id            String    @id @default(cuid())
  email         String
  codeHash      String
  linkTokenHash String?   @unique // the magic link carries this; either path consumes the row
  ipHash        String?
  expiresAt     DateTime
  attempts      Int       @default(0)
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

// Generic fixed-window rate-limit counter. Keyed by (scope, key) where key is a
// hashed identifier (email, ip fingerprint). Used for login-code issuance and
// verification attempts.
model RateLimit {
  scope           String
  key             String
  count           Int      @default(0)
  windowStartedAt DateTime @default(now())

  @@id([scope, key])
  @@index([windowStartedAt])
}

model Passkey {
  id         String    @id // credential ID, base64url
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  publicKey  Bytes
  counter    Int       @default(0)
  transports String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([accountId])
}

model TotpCredential {
  accountId          String    @id
  account            Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  secret             String // AES-256-GCM encrypted at rest
  confirmedAt        DateTime?
  recoveryCodeHashes String[] // single-use; hashed
  createdAt          DateTime  @default(now())
}

model Scenario {
  id          String   @id @default(cuid())
  externalId  String   @unique
  edition     String
  category    String?
  cardType    String   @default("scenario")
  scored      Boolean  @default(true)
  section     String?
  hackKey     String?
  title       String?
  prompt      String
  answersA    String
  answersB    String
  answersC    String
  answersD    String
  scoresA     Int
  scoresB     Int
  scoresC     Int
  scoresD     Int
  safeActions String?
  tags        String?
  explanation String?
  proTip      String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessionCards    ChallengeSessionCard[]
  comasyResponses ComasyResponse[]
  comasyProfile   ComasyScenarioProfile?
  comasyVersions  ComasyScenarioVersion[]

  @@index([edition, active, scored, hackKey])
}

model ChallengeSession {
  id              String                 @id @default(cuid())
  userId          String
  user            User                   @relation(fields: [userId], references: [id])
  edition         String
  mode            String                 @default("full")
  runNumber       Int                    @default(1)
  status          String                 @default("IN_PROGRESS")
  currentIndex    Int                    @default(0)
  scoreTotal      Int                    @default(0)
  scoreMax        Int                    @default(0)
  completedAt     DateTime?
  resultEmailedAt DateTime? // the results email is sent once per session
  cards           ChallengeSessionCard[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([userId])
}

model ChallengeSessionCard {
  id                String           @id @default(cuid())
  sessionId         String
  session           ChallengeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  scenarioId        String
  scenario          Scenario         @relation(fields: [scenarioId], references: [id])
  orderIndex        Int
  answered          Boolean          @default(false)
  selectedAnswerKey String?
  score             Int?
  createdAt         DateTime         @default(now())

  @@unique([sessionId, orderIndex])
  @@index([scenarioId])
  @@index([sessionId])
}

model Entitlement {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  tier           String
  edition        String?
  source         String   @default("shopify")
  shopifyOrderId String   @unique
  status         String   @default("active")
  createdAt      DateTime @default(now())

  @@index([userId])
}

model ComasyOrganization {
  id                 String    @id @default(cuid())
  name               String
  slug               String    @unique
  industry           String?
  country            String?
  employees          Int?
  nis2Relevant       Boolean   @default(false)
  accountOwner       String?
  source             String?
  persona            String?
  stage              String    @default("TARGET_ACCOUNT")
  currentPlatform    String?
  estimatedValue     Int       @default(0)
  nextAction         String?
  lastContactAt      DateTime?
  customerHealth     String    @default("PROSPECT")
  accessCodeHash     String?
  accessCodeSalt     String?
  contractStart      DateTime?
  contractEnd        DateTime?
  seats              Int?
  arr                Int       @default(0)
  renewalDate        DateTime?
  expansionPotential String?
  brandingName       String?
  retentionDays      Int       @default(365)
  isDemo             Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  contacts      ComasyContact[]
  cohorts       ComasyCohort[]
  participants  ComasyParticipant[]
  campaigns     ComasyCampaign[]
  responses     ComasyResponse[]
  opportunities ComasyOpportunity[]
  pilots        ComasyPilot[]
  activities    ComasyActivity[]
  revenueEvents ComasyRevenueEvent[]
  leads         ComasyLead[]

  @@index([stage])
  @@index([customerHealth])
  @@index([renewalDate])
}

model ComasyContact {
  id                 String             @id @default(cuid())
  organizationId     String
  organization       ComasyOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  firstName          String
  lastName           String
  jobTitle           String?
  persona            String?
  email              String
  linkedIn           String?
  buyingRole         String?
  decisionMaker      Boolean            @default(false)
  champion           Boolean            @default(false)
  technicalEvaluator Boolean            @default(false)
  procurement        Boolean            @default(false)
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  activities ComasyActivity[]

  @@index([organizationId])
  @@index([email])
}

model ComasyCohort {
  id             String             @id @default(cuid())
  organizationId String
  organization   ComasyOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  department     String?
  country        String?
  role           String?
  active         Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  participants ComasyParticipant[]
  campaigns    ComasyCampaign[]
  pilots       ComasyPilot[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model ComasyParticipant {
  id             String             @id @default(cuid())
  organizationId String
  organization   ComasyOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cohortId       String?
  cohort         ComasyCohort?      @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  firstName      String
  lastName       String
  email          String
  department     String?
  role           String?
  status         String             @default("INVITED")
  accessToken    String             @unique
  invitedAt      DateTime           @default(now())
  onboardedAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  responses ComasyResponse[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([cohortId])
  @@index([status])
}

model ComasyCampaign {
  id             String             @id @default(cuid())
  organizationId String
  organization   ComasyOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cohortId       String?
  cohort         ComasyCohort?      @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  name           String
  status         String             @default("DRAFT")
  designation    String             @default("PRACTICE")
  scheduledAt    DateTime?
  startAt        DateTime?
  endAt          DateTime?
  roleFocus      String?
  hackFocus      String?
  scenarioIds    String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  responses ComasyResponse[]

  @@index([organizationId])
  @@index([cohortId])
  @@index([status])
  @@index([designation])
}

model ComasyResponse {
  id                String             @id @default(cuid())
  organizationId    String
  organization      ComasyOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaignId        String
  campaign          ComasyCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  participantId     String
  participant       ComasyParticipant  @relation(fields: [participantId], references: [id], onDelete: Cascade)
  scenarioId        String
  scenario          Scenario           @relation(fields: [scenarioId], references: [id])
  selectedAnswerKey String
  score             Int
  pause             Boolean
  verification      Boolean
  impulse           Boolean
  hackKey           String
  createdAt         DateTime           @default(now())

  @@unique([campaignId, participantId, scenarioId])
  @@index([organizationId])
  @@index([campaignId])
  @@index([participantId])
  @@index([scenarioId])
  @@index([hackKey])
  @@index([createdAt])
}

model ComasyOpportunity {
  id             String             @id @default(cuid())
  organizationId String
  organization   ComasyOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  stage          String             @default("TARGET_ACCOUNT")
  estimatedValue Int                @default(0)
  probability    Int                @default(10)
  expectedClose  DateTime?
  nextAction     String?
  objection      String?
  owner          String?
  lostReason     String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([organizationId])
  @@index([stage])
  @@index([expectedClose])
}

model ComasyPilot {
  id               String             @id @default(cuid())
  organizationId   String
  organization     ComasyOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cohortId         String?
  cohort           ComasyCohort?      @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  startAt          DateTime?
  endAt            DateTime?
  objectives       String?
  successCriteria  String?
  health           String             @default("PLANNED")
  customerFeedback String?
  finalReviewDate  DateTime?
  conversionStatus String             @default("OPEN")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([organizationId])
  @@index([cohortId])
  @@index([conversionStatus])
  @@index([finalReviewDate])
}

model ComasyActivity {
  id             String              @id @default(cuid())
  organizationId String?
  organization   ComasyOrganization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        ComasyContact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  type           String
  source         String?
  medium         String?
  campaign       String?
  page           String?
  persona        String?
  metadata       String?
  createdAt      DateTime            @default(now())

  @@index([organizationId])
  @@index([contactId])
  @@index([type])
  @@index([source])
  @@index([createdAt])
}

model ComasyRevenueEvent {
  id             String             @id @default(cuid())
  organizationId String
  organization   ComasyOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           String
  amount         Int
  source         String             @default("manual")
  occurredAt     DateTime           @default(now())
  note           String?
  createdAt      DateTime           @default(now())

  @@index([organizationId])
  @@index([type])
  @@index([occurredAt])
}

model ComasyLead {
  id               String              @id @default(cuid())
  organizationId   String?
  organization     ComasyOrganization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  firstName        String
  lastName         String
  workEmail        String
  organizationName String
  role             String?
  organizationSize String?
  primaryObjective String?
  currentPlatform  String?
  notes            String?
  source           String?
  medium           String?
  campaign         String?
  landingPage      String?
  status           String              @default("NEW")
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([organizationId])
  @@index([workEmail])
  @@index([status])
  @@index([source])
  @@index([createdAt])
}

model ComasyScenarioProfile {
  id               String   @id @default(cuid())
  scenarioId       String   @unique
  scenario         Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  segment          String   @default("B2B")
  industries       String?
  roles            String?
  riskType         String?
  difficulty       String   @default("MEDIUM")
  pauseKeys        String?
  verificationKeys String?
  impulseKeys      String?
  version          Int      @default(1)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ComasyScenarioVersion {
  id         String   @id @default(cuid())
  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  version    Int
  snapshot   String
  createdBy  String?
  createdAt  DateTime @default(now())

  @@unique([scenarioId, version])
  @@index([scenarioId])
}

model GiftCode {
  id               String    @id @default(cuid())
  code             String    @unique
  tier             String
  edition          String?
  shopifyOrderId   String    @unique
  fromName         String?
  fromEmail        String?
  toEmail          String
  message          String?
  status           String    @default("issued") // issued | redeemed | revoked
  redeemedByUserId String?
  redeemedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([toEmail])
  @@index([status])
}

// --- Lockscreens (Workplace tier) --------------------------------------
// See docs/LOCKSCREENS_ARCHITECTURE.md. Content library + tenant/plan model
// for the Managed Deployment Engine. B2B purchase routes through a
// quote -> auto-generated PO, not instant checkout (per architecture §5).

model LockscreenAsset {
  id        String   @id @default(cuid())
  track     String // "workplace" | "school" | "home" | "teen" -- each track has its own numbering
  number    Int // within the track (1..60 for workplace/school; original source-pack numbers for home/teen)
  format    String // "desktop" | "notebook-16x10" | "notebook-3x2" | "tablet-landscape" | "tablet-portrait" | "phone"
  category  String
  hook      String
  body      String
  action    String
  imagePath String // "/lockscreens/{track}/{format}/NN.png"
  status    String   @default("live") // live | draft | retired
  createdAt DateTime @default(now())

  @@unique([track, number, format])
  @@index([status])
  @@index([track])
}

model LockscreenTenant {
  id            String            @id @default(cuid())
  kind          String // "workplace" | "school" | "home" | "teen"
  orgName       String
  token         String            @unique // opaque, for the /l/{token}/current/{device} delivery resolver
  tokenStatus   String            @default("active") // pending | active | expired
  adminToken    String            @unique // opaque, separate link for the self-serve admin (/lockscreens/workplace/admin/{adminToken})
  licensedCount Int // declared billing basis: employee headcount
  contactName   String?
  contactEmail  String
  termStart     DateTime?
  termEnd       DateTime?
  createdAt     DateTime          @default(now())
  plan          LockscreenPlan?
  orders        LockscreenOrder[]

  // The Konfydence account that manages this subscription, once linked.
  // Null until the account holder claims it (contactEmail match).
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([contactEmail])
  @@index([kind])
  @@index([accountId])
}

model LockscreenPlan {
  id          String           @id @default(cuid())
  tenantId    String           @unique
  tenant      LockscreenTenant @relation(fields: [tenantId], references: [id])
  sequence    Int[] // ordered asset numbers, length = screenCount
  screenCount Int              @default(27) // 27 | 54 | 60
  cadence     String           @default("fortnightly") // weekly | fortnightly | monthly
  anchor      DateTime         @default(now()) // sequence position 0 starts here
  loop        Boolean          @default(true)
  updatedAt   DateTime         @updatedAt
}

// One row per quote/order submitted through /lockscreens/workplace/order.
// Always produces a numbered PO immediately; a human still confirms payment
// terms before the licence goes live (tenant.tokenStatus flips to "active").
model LockscreenOrder {
  id                  String            @id @default(cuid())
  poNumber            String            @unique
  // Only set for Personal-engine (home/teen) orders, which come straight
  // from a paid Shopify order rather than the B2B quote->PO flow -- used
  // for webhook idempotency (retries) and cancellation/refund lookup.
  shopifyOrderId      String?           @unique
  tenantId            String?
  tenant              LockscreenTenant? @relation(fields: [tenantId], references: [id])
  orgName             String
  contactName         String?
  contactEmail        String
  billingAddress      String?
  employeeCount       Int
  screenCount         Int // 27 | 54 | 60
  cadence             String // weekly | fortnightly | monthly
  sequence            Int[] // chosen asset numbers, length = screenCount
  baseRatePerHead     Float // $4.00 base rate at time of order
  surchargePerHead    Float             @default(0) // extended-library add-on ($1/head for 54/60 screens)
  ratePerHead         Float // baseRatePerHead + surchargePerHead
  annualTotal         Float // max(employeeCount * ratePerHead, minimumAnnual), unless overridden below
  minimumApplied      Boolean           @default(false)
  currency            String            @default("USD")
  status              String            @default("quote_issued") // quote_issued | confirmed | cancelled
  notes               String?
  // Negotiated pricing: set only from the internal /admin tool (Basic-Auth
  // gated). When present, this replaces annualTotal as the billed figure on
  // the PO and admin dashboard — the calculated rate stays on record as the
  // list-price baseline.
  overrideAnnualTotal Float?
  overrideReason      String?
  overriddenBy        String?
  overriddenAt        DateTime?
  createdAt           DateTime          @default(now())

  @@index([contactEmail])
  @@index([status])
}
