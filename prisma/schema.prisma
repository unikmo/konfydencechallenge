generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Production foundation: PostgreSQL via Supabase. Free-text fields are retained
// where deck-specific content needs flexibility without weakening runtime validation.

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  sessions     ChallengeSession[]
  entitlements Entitlement[]
}

model Scenario {
  id         String @id @default(cuid())
  externalId String @unique

  // "travelsafe" | "university" | "workplace" | "school" | "family"
  edition String

  // Deck-specific content grouping (e.g. "Gaming/Social", "Money").
  category String?

  // "scenario" (scored solo web) | "wild" (host-mode only, excluded from solo scoring)
  cardType String @default("scenario")
  scored   Boolean @default(true)

  // Legacy sequencing bucket. The live 40-card bank model no longer sequences by section.
  section String?

  // H.A.C.K. pressure key: H=Hurry, A=Authority, C=Comfort, K=Kill-Switch.
  // Null only for non-scored/wild cards.
  hackKey String?

  title  String?
  prompt String

  answersA String
  answersB String
  answersC String
  answersD String // legacy compatibility; scored web scenarios leave D blank

  // Normalized 0..4. Import clamps defensive input; quality CI enforces valid source scores.
  scoresA Int
  scoresB Int
  scoresC Int
  scoresD Int

  // Stored as comma-separated strings for schema compatibility.
  safeActions String? // e.g. "A,B"
  tags        String? // e.g. "travel,phishing,diagnostic"

  explanation String?
  proTip      String?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessionCards ChallengeSessionCard[]
}

model ChallengeSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // "travelsafe" | "university" | "workplace" | "school" | "family"
  edition String

  // diagnostic = 8 scored cards (2 per H/A/C/K); full = 24 (6 per key) from a 40-card bank.
  mode String @default("full")

  // 1-based attempt count for this user + edition + mode.
  runNumber Int @default(1)

  // "IN_PROGRESS" | "COMPLETED"
  status String @default("IN_PROGRESS")

  // Flat pointer into cards ordered by orderIndex. Persisting the order prevents refresh reshuffles.
  currentIndex Int @default(0)
  scoreTotal   Int @default(0)
  scoreMax     Int @default(0)

  completedAt DateTime?
  cards       ChallengeSessionCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ChallengeSessionCard {
  id String @id @default(cuid())

  sessionId String
  session   ChallengeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id])

  orderIndex Int

  answered          Boolean @default(false)
  selectedAnswerKey String? // "A" | "B" | "C"; D exists only for legacy schema compatibility
  score             Int?    // 0..4, set once answered

  createdAt DateTime @default(now())

  @@unique([sessionId, orderIndex])
  @@index([scenarioId])
  @@index([sessionId])
}

model Entitlement {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  tier    String  // "single" | "unlimited"
  edition String? // set when tier = "single"; null covers all editions

  source         String @default("shopify")
  shopifyOrderId String @unique
  status         String @default("active") // "active" | "revoked"
  createdAt      DateTime @default(now())

  @@index([userId])
}
